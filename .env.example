# Copy to .env for a self-hosted installation, or set variables in your host.
# Never commit real credentials. The local preview works without cloud keys.

# Node 24 local server; put an HTTPS reverse proxy in front for cloud sign-in.
HOST=127.0.0.1
PORT=3000
CHLOM_PUBLIC_ORIGIN=
# Enable only when direct access to this port is restricted to your proxy.
CHLOM_TRUST_PROXY=false

# Explicit installation backend. No service-role or secret key belongs here.
# Requires a compatible provisioned CHLOM backend; see docs/INSTALLATION.md.
CHLOM_LEX_SUPABASE_URL=
CHLOM_LEX_SUPABASE_PUBLISHABLE_KEY=

# Random server-only secret of at least 32 bytes for wallet-control observations.
# Use a distinct value from your API token. Never enter a wallet private key.
CHLOM_WALLET_CHALLENGE_SECRET=

# Optional approved policy and utility registries, JSON up to 64 KiB each.
# Leave unset until authoritative registry content is available for your tenant.
CHLOM_PROTOCOL_POLICY_JSON=
CHLOM_PROTOCOL_UTILITY_JSON=

# Required API perimeter
CHLOM_API_TOKEN=
CHLOM_ALLOWED_ORIGINS=
CHLOM_GOVERNANCE_STATE=hold
CHLOM_CHAIN_WRITE_ENABLED=false
CHLOM_ECAC_DIGEST=

# Google Cloud / Vercel OIDC Workload Identity Federation
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_BIGQUERY_LOCATION=US
CHLOM_BIGQUERY_MAX_BYTES_BILLED=536870912

# Provider-neutral RPC endpoints. Store complete HTTPS endpoint URLs.
# Preferred durable provider
QUICKNODE_RPC_BASE=
QUICKNODE_RPC_BASE_SEPOLIA=
QUICKNODE_RPC_ETHEREUM=

# CrownThrive-managed/custom provider endpoint
CHLOM_RPC_BASE=
CHLOM_RPC_BASE_SEPOLIA=
CHLOM_RPC_ETHEREUM=

# Transitional only: Google Blockchain RPC shuts down 2026-12-15
GOOGLE_BLOCKCHAIN_RPC_BASE=
GOOGLE_BLOCKCHAIN_RPC_ETHEREUM=

# Optional additional providers
ALCHEMY_RPC_BASE=
ALCHEMY_RPC_ETHEREUM=
INFURA_RPC_ETHEREUM=
