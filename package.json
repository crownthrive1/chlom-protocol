{
  "name": "@crownthrive/chlom-chain-evidence-fabric",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "CHLOM core control plane, governed operator console, protocol verification and chain evidence runtime.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "core": "node --env-file-if-exists=.env.local scripts/core-cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "certify": "npm test && npm run build",
    "start": "node --env-file-if-exists=.env.local scripts/serve-local.mjs",
    "preflight": "node --env-file-if-exists=.env.local scripts/install-preflight.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@vercel/oidc": "3.8.0",
    "ethers": "6.17.0",
    "google-auth-library": "11.0.2"
  }
}
