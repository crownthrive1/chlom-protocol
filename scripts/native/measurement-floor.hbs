use core::marker::PhantomData;
use frame_support::{traits::Get, weights::Weight};

pub struct MeasuredWeight<T>(PhantomData<T>);
impl<T: frame_system::Config> crate::weights::WeightInfo for MeasuredWeight<T> {
{{#each benchmarks as |b|}}
    /// Observed proof base: {{b.base_recorded_proof_size}} bytes. SDK-estimated proof base: {{b.base_calculated_proof_size}} bytes.
    /// Minimum observed execution time: {{b.min_execution_time}} nanoseconds.
    {{#each b.component_ranges as |range|}}
    /// Measured {{range.name}} range: {{range.min}}..={{range.max}}.
    {{/each}}
    fn {{b.name}}({{#each b.components as |c|}}{{c.name}}: u32, {{/each}}) -> Weight {
        let measured = Weight::from_parts({{b.base_weight}}, {{b.base_calculated_proof_size}})
            {{#each b.component_weight as |c|}}
            .saturating_add(Weight::from_parts({{c.slope}}, 0).saturating_mul({{c.name}}.into()))
            {{/each}}
            .saturating_add(T::DbWeight::get().reads({{b.base_reads}}))
            {{#each b.component_reads as |c|}}
            .saturating_add(T::DbWeight::get().reads({{c.slope}}_u64.saturating_mul({{c.name}}.into())))
            {{/each}}
            .saturating_add(T::DbWeight::get().writes({{b.base_writes}}))
            {{#each b.component_writes as |c|}}
            .saturating_add(T::DbWeight::get().writes({{c.slope}}_u64.saturating_mul({{c.name}}.into())))
            {{/each}}
            {{#each b.component_calculated_proof_size as |c|}}
            .saturating_add(Weight::from_parts(0, {{c.slope}}).saturating_mul({{c.name}}.into()))
            {{/each}}
            ;
        let floor = <crate::weights::SubstrateWeight<T> as crate::weights::WeightInfo>::{{b.name}}({{#each b.components as |c|}}{{c.name}}, {{/each}});
        Weight::from_parts(measured.ref_time().max(floor.ref_time()), measured.proof_size().max(floor.proof_size()))
    }
{{/each}}
}
